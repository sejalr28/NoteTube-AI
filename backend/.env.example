# Rename this file to .env and fill in your actual values

# --- LLM Provider ---
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model used for chat/summarization (Groq-hosted LLaMA 3 is fast + free-tier friendly)
LLM_MODEL=llama-3.1-8b-instant

# --- Embedding Model ---
# Runs locally via sentence-transformers, no API key needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking Config ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- RAG Config ---
TOP_K_RESULTS=4

# --- FAISS index storage ---
FAISS_INDEX_DIR=./faiss_indexes
